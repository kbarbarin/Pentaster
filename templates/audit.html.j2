<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pentaster — audit générique — {{ target }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root { 
      color-scheme: light;
      --bg-body: #f8fafc;
      --bg-surface: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --primary: #3b82f6;
      --border-radius-lg: 12px;
      --border-radius-md: 8px;
      --border-radius-sm: 6px;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    }
    body { 
      font-family: 'Inter', system-ui, -apple-system, sans-serif; 
      margin: 0; 
      padding: 3rem 2rem;
      color: var(--text-main); 
      background: var(--bg-body); 
      line-height: 1.5;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
    }
    .header {
      background: var(--bg-surface);
      padding: 2.5rem;
      border-radius: var(--border-radius-lg);
      box-shadow: var(--shadow-md);
      margin-bottom: 2rem;
    }
    h1 { 
      font-size: 2.25rem; 
      font-weight: 700;
      margin: 0 0 .5rem 0; 
      color: var(--text-main);
      letter-spacing: -0.025em;
    }
    h2 { 
      font-size: 1.25rem; 
      font-weight: 600;
      margin: 2.5rem 0 1rem 0.5rem; 
      color: var(--text-main);
    }
    .meta { color: var(--text-muted); font-size: 0.95rem; margin-top: 0.5rem; }
    .meta code { 
      background: var(--bg-body); 
      padding: 0.2rem 0.5rem; 
      border-radius: var(--border-radius-sm); 
      color: var(--primary);
      font-weight: 600;
      border: 1px solid var(--border-color);
    }
    .chips { margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .chip { 
      color: #fff; 
      padding: 0.4rem 1rem; 
      border-radius: 9999px; 
      font-size: 0.85rem; 
      font-weight: 600;
      box-shadow: var(--shadow-sm);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      cursor: default;
    }
    .chip:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }
    .table-container {
      background: var(--bg-surface);
      border-radius: var(--border-radius-lg);
      box-shadow: var(--shadow-md);
      overflow: hidden;
    }
    table { border-collapse: collapse; width: 100%; text-align: left; }
    th, td { 
      padding: 1.25rem 1.5rem; 
      border-bottom: 1px solid var(--border-color); 
      vertical-align: middle; 
    }
    th { 
      background: #f1f5f9; 
      color: var(--text-main); 
      font-weight: 600;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    tbody tr {
      transition: background-color 0.15s ease;
    }
    tbody tr:hover {
      background-color: #f8fafc;
    }
    tbody tr:last-child td {
      border-bottom: none;
    }
    .sev { 
      color: #fff; 
      padding: 0.35rem 0.85rem; 
      border-radius: 9999px; 
      font-size: 0.75rem; 
      font-weight: 700;
      text-transform: uppercase;
      display: inline-block;
      box-shadow: var(--shadow-sm);
    }
    code, .mono { 
      font-family: 'ui-monospace', 'SFMono-Regular', Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; 
      font-size: 0.875rem; 
    }
    .muted { color: var(--text-muted); }
    footer { 
      margin-top: 4rem; 
      text-align: center;
      color: var(--text-muted); 
      font-size: 0.875rem; 
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Rapport Pentaster — Audit générique</h1>
      <p class="meta">
        <b>Cible :</b> <code>{{ target }}</code> &nbsp;·&nbsp;
        <b>Généré le :</b> {{ generated_at }}
      </p>

      <div class="chips">
        {% for sev in ["critical", "high", "medium", "low", "info"] %}
          {% if counts.get(sev) %}
            <span class="chip" style="background: {{ sev | sev_color }}">{{ sev | capitalize }}: {{ counts[sev] }}</span>
          {% endif %}
        {% endfor %}
        {% if not findings %}<span class="muted">Aucun finding.</span>{% endif %}
      </div>
    </div>

    <h2>Findings ({{ findings | length }})</h2>
    <div class="table-container">
      <table>
        <thead>
          <tr><th>Sévérité</th><th>Technique</th><th>URL</th><th>Preuve</th></tr>
        </thead>
        <tbody>
          {% for f in findings %}
          <tr>
            <td><span class="sev" style="background: {{ f.severity | sev_color }}">{{ f.severity | capitalize }}</span></td>
            <td>{{ f.technique }}</td>
            <td class="mono">{{ f.url }}</td>
            <td class="mono muted">{{ f.evidence }}</td>
          </tr>
          {% else %}
          <tr><td colspan="4" class="muted" style="text-align: center; padding: 3rem;">Aucun finding trouvé.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <footer>Généré par Pentaster le {{ generated_at }} · Usage sur cibles autorisées uniquement.</footer>
  </div>
</body>
</html>
