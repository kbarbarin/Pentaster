<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pentaster — scan — {{ report.target }}</title>
  <style>
    :root { color-scheme: light; }
    body { font-family: system-ui, "Segoe UI", sans-serif; margin: 2rem; color: #0f172a; background: #f8fafc; }
    h1 { font-size: 1.5rem; margin-bottom: .25rem; }
    h2 { font-size: 1.15rem; margin-top: 2.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: .3rem; }
    h3 { font-size: 1rem; margin-top: 1.5rem; }
    .meta { color: #475569; font-size: .9rem; }
    .meta code { background: #eef2f7; padding: .1rem .35rem; border-radius: .25rem; }
    .chips { margin: 1rem 0; }
    .chip, .sev { color: #fff; padding: .18rem .55rem; border-radius: .4rem; font-size: .8rem; margin-right: .35rem; display: inline-block; }
    .chip.tech { background: #334155; }
    .chip.ok { background: #15803d; }
    .chip.warn { background: #b45309; }
    table { border-collapse: collapse; width: 100%; background: #fff; margin-top: .5rem; }
    th, td { border: 1px solid #e2e8f0; padding: .5rem .6rem; text-align: left; font-size: .87rem; vertical-align: top; }
    th { background: #0f172a; color: #fff; position: sticky; top: 0; }
    code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .8rem; }
    .muted { color: #64748b; }
    .callout { background: #fffbeb; border: 1px solid #fde68a; border-radius: .5rem; padding: .75rem 1rem; margin-top: .75rem; font-size: .87rem; }
    .callout ul { margin: .35rem 0 0 1.1rem; }
    .table-wrap { overflow-x: auto; }
    footer { margin-top: 2.5rem; color: #94a3b8; font-size: .8rem; }
    @media (prefers-color-scheme: dark) {
      body { background: #0b1220; color: #e2e8f0; }
      .meta { color: #94a3b8; }
      .meta code { background: #1e293b; }
      table { background: #111827; }
      th, td { border-color: #1f2937; }
      th { background: #1e293b; }
      .muted { color: #94a3b8; }
      .callout { background: #1c1917; border-color: #78350f; color: #fde68a; }
    }
  </style>
</head>
<body>
  <h1>Rapport Pentaster — Scan complet</h1>
  <p class="meta">
    <b>Cible :</b> <code>{{ report.target }}</code> ·
    <b>Hôte scope :</b> <code>{{ report.recon.host }}</code> ·
    <b>Authentifié :</b> {% if report.sitemap.authenticated %}<span class="chip ok">oui</span>{% else %}<span class="chip warn">non</span>{% endif %} ·
    <b>Généré le :</b> {{ generated_at }} ·
    <b>Début :</b> {{ report.started_at }} · <b>Fin :</b> {{ report.finished_at }}
  </p>

  <!-- ============================== RECON ============================== -->
  <h2>1. Recon</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Port</th><th>Protocole</th><th>État</th><th>Service</th><th>Produit</th><th>Version</th></tr></thead>
      <tbody>
        {% for s in report.recon.services %}
        <tr>
          <td>{{ s.port }}</td><td>{{ s.proto }}</td><td>{{ s.state }}</td>
          <td>{{ s.name }}</td><td>{{ s.product }}</td><td>{{ s.version }}</td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="muted">Aucun port ouvert détecté.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="chips">
    {% for t in report.recon.tech %}
      <span class="chip tech">{{ t }}</span>
    {% else %}
      <span class="muted">Aucune technologie détectée.</span>
    {% endfor %}
  </div>

  {% if report.recon.notes %}
  <div class="callout">
    <b>À noter :</b>
    <ul>
      {% for n in report.recon.notes %}<li>{{ n }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  <!-- ============================ CARTOGRAPHIE ============================ -->
  <h2>2. Cartographie</h2>
  <p class="meta">
    {{ report.sitemap.endpoints | length }} endpoint(s) · {{ report.sitemap.forms | length }} formulaire(s) ·
    {{ report.sitemap.api_endpoints | length }} endpoint(s) API
  </p>

  <h3>Endpoints ({{ report.sitemap.endpoints | length }})</h3>
  <div class="table-wrap">
    <table>
      <thead><tr><th>URL</th><th>Méthode</th><th>Source</th><th>Paramètres</th></tr></thead>
      <tbody>
        {% for e in report.sitemap.endpoints %}
        <tr>
          <td class="mono">{{ e.url }}</td><td>{{ e.method }}</td><td>{{ e.source }}</td>
          <td class="mono muted">{{ e.params | join(", ") }}</td>
        </tr>
        {% else %}
        <tr><td colspan="4" class="muted">Aucun endpoint découvert.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h3>Formulaires ({{ report.sitemap.forms | length }})</h3>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Action</th><th>Méthode</th><th>Champs</th></tr></thead>
      <tbody>
        {% for f in report.sitemap.forms %}
        <tr>
          <td class="mono">{{ f.action }}</td><td>{{ f.method }}</td>
          <td class="mono muted">{% for name, typ in f.fields %}{{ name }}:{{ typ }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
        </tr>
        {% else %}
        <tr><td colspan="3" class="muted">Aucun formulaire découvert.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h3>Endpoints API ({{ report.sitemap.api_endpoints | length }})</h3>
  <div class="table-wrap">
    <table>
      <thead><tr><th>URL</th><th>Méthode</th><th>Source</th></tr></thead>
      <tbody>
        {% for e in report.sitemap.api_endpoints %}
        <tr><td class="mono">{{ e.url }}</td><td>{{ e.method }}</td><td>{{ e.source }}</td></tr>
        {% else %}
        <tr><td colspan="3" class="muted">Aucun endpoint API repéré.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- ======================= VULNÉRABILITÉS PAR CATÉGORIE ======================= -->
  <h2>3. Vulnérabilités par catégorie</h2>

  <div class="chips">
    {% for sev in ["critical", "high", "medium", "low", "info"] %}
      {% if counts.get(sev) %}
        <span class="chip" style="background: {{ sev | sev_color }}">{{ sev | capitalize }}: {{ counts[sev] }}</span>
      {% endif %}
    {% endfor %}
    {% if not report.findings %}<span class="muted">Aucun finding.</span>{% endif %}
  </div>

  {% for category, items in by_category.items() %}
  <h3>{{ category }} ({{ items | length }})</h3>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Sévérité</th><th>Technique</th><th>URL</th><th>Preuve</th></tr></thead>
      <tbody>
        {% for f in items %}
        <tr>
          <td><span class="sev" style="background: {{ f.severity | sev_color }}">{{ f.severity | capitalize }}</span></td>
          <td>{{ f.technique }}</td>
          <td class="mono">{{ f.url }}</td>
          <td class="mono muted">{{ f.evidence }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="muted">Aucune vulnérabilité confirmée.</p>
  {% endfor %}

  <!-- ============================ JOURNAL D'EXÉCUTION ============================ -->
  <h2>4. Journal d'exécution</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Horodatage</th><th>Phase</th><th>Événement</th><th>Détail</th></tr></thead>
      <tbody>
        {% for ev in report.timeline %}
        <tr>
          <td class="mono">{{ ev.ts }}</td><td>{{ ev.phase }}</td><td>{{ ev.event }}</td>
          <td class="mono muted">{{ ev.detail }}</td>
        </tr>
        {% else %}
        <tr><td colspan="4" class="muted">Journal vide.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <footer>Généré par Pentaster le {{ generated_at }} · Usage sur cibles autorisées uniquement.</footer>
</body>
</html>
